from math import log, log2, log10, floor
from collections import Counter
from wrappers import printTimeTaken

def digitLength(n, base = 10):
    """
    Returns the number of digits necessary to represent n
    """
    if n < 0:
        n *= -1 
    
    if n < base:
        return 1
    
    logged = floor(log(n,base)) + 1

    while pow(base, logged) <= n: # Have to do this bull
        logged += 1 # Because log is not super accurate

    return logged

def digits(n, base = 10, reverse = False):
    """
    Returns the digits of a positive integer 
    index corresponds to power of base
    """
    if n < 0:
        n *= -1

    m = digitLength(n, base)
    digs = [(n // (base**i)) % base for i in range(m)]

    return digs if not reverse else digs[::-1]

def permuteDigits(dig, perm):
    # Returns the digits after a permutation
    if len(dig) < len(perm):
        dig = dig + (len(perm) - len(dig)) * [0]

    newDig = [dig[p] for p in perm]

    if len(dig) > len(perm):
        newDig = newDig + dig[len(perm):]

    return newDig


def sameDigits(n, m, base = 10):
    # Determines if two numbers have the same digits in the given base
    digN = Counter(digits(n, base))
    digM = Counter(digits(m, base))

    return digN == digM

def digitsToNum(dig, base = 10, reverse = False):
    # Takes in a list of digits and spits out the number
    # Is oriented based on the index
    # Reverse set to true reverses this

    n = 0
    m = len(dig)-1
    
    for i, d in enumerate(dig):
        a = i if not reverse else m - i
        n += d * (base**a)

    return n

def digitPowerSum(n, power = 1, base = 10):
    # Gets the sum of the powers of the digits in given base
    # Only non-negative integer powers for now
    if n < base:
        return pow(n, power)
    
    return digitPowerSum(n // base, power, base) + pow(n % base, power)

def digitSum(n, base = 10):
    # Gets the digit sum of a positive integer n in the given base
    
    return digitPowerSum(n, 1, base = 10)

    
def partialDigitSums(n, part, base = 10):
    # Gets the sum of the powers of the digits based on the powers in part
    # Every element of part is a list of powers + 1

    s = 0
    digs = digits(n, base)

    for p in part:
        if len(p) > 1:
            s += digitsToNum([digs[i-1] for i in p], base)
        else:
            s += digs[p[0]-1]
    return s

def digitalRoot(n, base = 10):
    if n < 0:
        n *= -1

    if n < base:
        return n
 
    m = n % (base - 1)

    if m == 0:
        return base - 1
    else:
        return m
    
def inverseDigitSum(n, base = 10):
    # Gets the smallest integer m with given digit sum n
    m = base - 1
    q = n // m # min number of digits to obtain n

    if n % m == 0:
        return digitsToNum(q*[m], base = base)
    
    digs = (q * [m]) + [n % m] 

    return digitsToNum(digs, base = base)


def isDigitSumNumber(n, base = 10):
    # Returns true if n is a digit sum number

    
    digs = digits(n, base = base)
    s = sum(digs)

    if s > 2*(base - 1) or s == 1:
        return False

    return (s // 2) in digs


def lycherelSum(n, base = 10):
    # Returns the lycherel sum of a number with its reverse

    digN = digits(n, base)
    revN = digitsToNum(digN, base, True)

    return n + revN

def isLycherel(n, base = 10, numSteps = 51):
    # Tests if n is lycherel, stopping after numSteps runs
    s = lycherelSum(n, base)
    
    if numSteps == 1:
        return not isPalindrome(s, base)

    if not isPalindrome(s, base):
        return isLycherel(s, base, numSteps-1)
    
    return False

def isPandigital(n, base = 10):
    m = digitLength(n, base)

    if m >= base:
        return False
    
    digs = digits(n, base)

    for i in range(1, m+1):
        if i not in digs:
            return False
        
    return True

def isPalindrome(n, base = 10):
    digs = digits(n, base)
    
    if digs[0] == 0:
        return False

    return digs == digs[::-1]

def champernowne(n, base = 10):
    # Gives the nth digit of the champernowne constant in base
    if n < base:
        return n
    
    s = 0
    m = 0
    p = 0

    while s < n:
        p = n - s
        m += 1
        s += m * (base ** (m-1)) * (base - 1)
    
    i = p % m
    if p <= m:
        return 1 if i == 1 else 0

    if i == 0:
        d = ((p - m) // m) 
    else:
        d = ((p - i) // m) // (base ** (m -i))

    d = d % base

    if i == 1:
        d += 1

    return d

def pandigitals(n, base = 10):
    # Return all n-pandigital numbers in the given base
    if n >= base or n < 0:
        return []
    
    def pandigitalsList(n, base = 10):
        # Returns all n-pandigital numbers in the given base as a list
        if n == 1:
            return [[1]]
        
        pandigs = pandigitalsList(n-1, base)

        output = []

        for p in pandigs:
            for i in range(n):
                q = p[:]
                q.insert(i,n)
                output.append(q)

        return output

    return [digitsToNum(p, base) for p in pandigitalsList(n, base)]

def allPandigitals(base = 10):
    # Returns all pandigital numbers for a given base
    pds = [pandigitals(i, base) for i in range(1,base)]
    output = []

    for pd in pds:
        output.extend(pd)

    return output

def increasingOrDecreasingNumber(n, base = 10):
    # Determines if a given number is increasing
    # Returns "inc" if increasing
    # Returns "dec" if decreasing
    # Returns "bouncy" if neither
    # Returns "inc" if both inc and dec

    digs = digits(n, base, reverse=True)
    inc = True
    dec = True

    if len(digs) == 1:
        return "inc"

    for i, d in enumerate(digs[:-1]):
        if d < digs[i+1]:
            dec = False
            if not inc:
                break
        elif d > digs[i+1]:
            inc = False
            if not dec:
                break

    if inc:
        return "inc"
    elif dec:
        return "dec"
    else:
        return "bouncy"
    
